# Chuyen www.kt-soft.vn ve kt-soft.vn (1 dia chi chinh duy nhat)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.kt-soft\.vn$ [NC]
RewriteRule ^(.*)$ https://kt-soft.vn/$1 [L,R=301,NE]

## ONEPANEL Force HTTPS by SSL installation
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]
## ONEPANEL Force HTTPS by SSL installation end

# Cho phep truy cap /admin (khong dau / cuoi) di thang vao thu muc admin/
RewriteRule ^admin$ admin/ [R=301,L]

# Chan truy cap truc tiep cac file include (chi de PHP nap noi bo)
RedirectMatch 403 ^/inc_[a-z_]+\.php$

# Bao mat: CSP day du (website chi dung font Google + anh cung ten mien) va cac header phu
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
